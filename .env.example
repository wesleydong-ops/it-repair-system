# JWT 密钥（生产环境必须修改为随机字符串）
JWT_SECRET=your-random-secret-key-change-in-production

# 端口配置
HTTP_PORT=8080
HTTPS_PORT=8443

# 邮件配置（可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false

# Webex 配置（可选）
WEBEX_TOKEN=
WEBEX_ROOM_ID=

# 系统访问地址（用于生成二维码和通知链接）
SYSTEM_URL=https://your-nas-domain:4433
