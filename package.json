{
  "name": "it-repair-system",
  "version": "1.0.0",
  "description": "IT设备扫码报修系统",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development nodemon --watch api --exec ts-node api/server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:server": "tsc --project api/tsconfig.json",
    "start": "NODE_ENV=production node dist/server.js",
    "start:dev": "NODE_ENV=development ts-node api/server.ts",
    "start:prod": "NODE_ENV=production ts-node api/server.ts",
    "lint": "eslint . --ext .ts,.vue",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-vue-next": "^0.314.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.9",
    "pg": "^8.11.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.21.1",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
